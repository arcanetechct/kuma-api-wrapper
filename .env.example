# Your Uptime Kuma base URL (no trailing slash)
KUMA_URL=https://status.arcanetechct.com

# A Kuma login (create a dedicated one for this bridge if you'd rather not
# reuse your own admin account)
KUMA_USERNAME=
KUMA_PASSWORD=

# Any long random string -- this protects the bridge's own HTTP endpoints.
# Generate one with: openssl rand -hex 32
BRIDGE_API_KEY=

# Optional: numeric Kuma notification ID to auto-attach to every monitor this
# bridge creates. Leave blank to attach no notifications (add them by hand in
# the Kuma UI afterwards).
KUMA_DEFAULT_NOTIFICATION_ID=

PORT=3000
